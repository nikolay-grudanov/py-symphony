{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://symphony.dev/schemas/workflow-state.schema.json",
  "title": "WorkflowState",
  "description": "Represents the current state of a workflow execution, including the current stage, accumulated artifacts, execution history, and metadata. This schema is used to track the progress and state of multi-stage build or development workflows.",
  "type": "object",
  "required": ["workflow_id", "current_state", "artifacts", "history"],
  "properties": {
    "workflow_id": {
      "type": "string",
      "description": "Unique identifier for the workflow execution",
      "pattern": "^[a-z0-9][a-z0-9\\-]*[a-z0-9]$",
      "examples": ["wf-20260411-001", "build-prod-main-abc123", "workflow-user-auth-xyz789"]
    },
    "current_state": {
      "type": "string",
      "description": "Current state or stage of the workflow",
      "examples": ["initialized", "requirements-analysis", "architecture-design", "implementation", "testing", "deployment", "completed", "failed", "paused", "cancelled"]
    },
    "artifacts": {
      "type": "array",
      "description": "List of artifacts produced during the workflow execution",
      "items": {
        "type": "object",
        "description": "Workflow artifact reference",
        "required": ["id", "type", "stage"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the artifact"
          },
          "type": {
            "type": "string",
            "description": "Type of the artifact",
            "enum": ["adr", "sdd", "diagram", "config", "code", "test", "document", "data", "output"]
          },
          "stage": {
            "type": "string",
            "description": "Stage during which this artifact was created"
          },
          "status": {
            "type": "string",
            "description": "Status of the artifact",
            "enum": ["draft", "in_review", "approved", "rejected"],
            "default": "draft"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "history": {
      "type": "array",
      "description": "Chronological history of state transitions and events in the workflow",
      "items": {
        "type": "object",
        "description": "Workflow state transition or event record",
        "required": ["timestamp", "event", "from_state", "to_state"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when the event occurred",
            "examples": ["2026-04-11T14:30:00Z"]
          },
          "event": {
            "type": "string",
            "description": "Type of event that occurred",
            "enum": ["initialized", "state_transition", "stage_started", "stage_completed", "stage_failed", "agent_handoff", "artifact_created", "error_occurred", "paused", "resumed", "cancelled", "completed"],
            "examples": ["state_transition", "stage_completed", "agent_handoff"]
          },
          "from_state": {
            "type": "string",
            "description": "Previous state before this event"
          },
          "to_state": {
            "type": "string",
            "description": "New state after this event"
          },
          "agent": {
            "type": "string",
            "description": "Agent associated with this event (if applicable)",
            "examples": ["build-orchestrator", "platform-architect", "backend-developer"]
          },
          "details": {
            "type": "object",
            "description": "Additional details about the event",
            "properties": {
              "message": {"type": "string", "description": "Human-readable message about the event"},
              "error_code": {"type": "string", "description": "Error code if event was an error"},
              "error_message": {"type": "string", "description": "Error message if event was an error"},
              "stage": {"type": "string", "description": "Build stage name"},
              "duration_seconds": {"type": "number", "description": "Duration of the stage or operation in seconds"},
              "handoff_to": {"type": "string", "description": "Target agent for handoff events"},
              "artifact_id": {"type": "string", "description": "ID of created artifact"}
            },
            "additionalProperties": true
          }
        }
      },
      "minItems": 1
    },
    "metadata": {
      "type": "object",
      "description": "Metadata about the workflow execution",
      "required": ["created_at"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the workflow was created",
          "examples": ["2026-04-11T10:00:00Z"]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the workflow was last updated",
          "examples": ["2026-04-11T14:30:00Z"]
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the workflow started execution"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the workflow completed (null if not completed)"
        },
        "created_by": {
          "type": "string",
          "description": "User or system that created the workflow",
          "examples": ["user@example.com", "system", "scheduled-job"]
        },
        "workflow_type": {
          "type": "string",
          "description": "Type or template of the workflow",
          "examples": ["standard-build", "feature-development", "hotfix", "documentation-update"]
        },
        "priority": {
          "type": "string",
          "description": "Priority level of the workflow",
          "enum": ["low", "medium", "high", "critical"],
          "default": "medium"
        },
        "issue_id": {
          "type": "string",
          "description": "Associated issue or ticket ID if this workflow addresses a specific issue",
          "examples": ["PROJ-123", "ISS-001"]
        },
        "branch": {
          "type": "string",
          "description": "Git branch associated with this workflow",
          "examples": ["main", "feature/user-auth", "hotfix/login-bug"]
        },
        "commit": {
          "type": "string",
          "description": "Git commit hash associated with this workflow",
          "examples": ["abc123def456789", "987fedcba654321"]
        },
        "environment": {
          "type": "string",
          "description": "Target deployment environment",
          "enum": ["development", "staging", "production"],
          "default": "development"
        },
        "tags": {
          "type": "array",
          "description": "Tags for categorizing and filtering workflows",
          "items": {"type": "string"},
          "uniqueItems": true,
          "examples": [["feature", "authentication"], ["bugfix", "critical"]]
        },
        "progress": {
          "type": "object",
          "description": "Progress tracking information",
          "properties": {
            "total_stages": {
              "type": "integer",
              "description": "Total number of stages in the workflow",
              "minimum": 1
            },
            "completed_stages": {
              "type": "integer",
              "description": "Number of stages completed",
              "minimum": 0
            },
            "percentage": {
              "type": "number",
              "description": "Overall progress percentage (0-100)",
              "minimum": 0,
              "maximum": 100
            },
            "current_stage": {
              "type": "string",
              "description": "Name of the current stage being executed"
            }
          }
        },
        "configuration": {
          "type": "object",
          "description": "Workflow configuration parameters",
          "additionalProperties": true,
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "description": "Maximum allowed execution time in seconds",
              "minimum": 60
            },
            "retry_on_failure": {
              "type": "boolean",
              "description": "Whether to automatically retry failed stages",
              "default": false
            },
            "max_retries": {
              "type": "integer",
              "description": "Maximum number of retry attempts",
              "minimum": 1,
              "default": 3
            },
            "notifications": {
              "type": "object",
              "description": "Notification settings",
              "properties": {
                "on_success": {"type": "array", "items": {"type": "string"}, "description": "Email addresses to notify on success"},
                "on_failure": {"type": "array", "items": {"type": "string"}, "description": "Email addresses to notify on failure"},
                "on_completion": {"type": "array", "items": {"type": "string"}, "description": "Email addresses to notify on completion"}
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "workflow_id": "wf-20260411-001",
      "current_state": "implementation",
      "artifacts": [
        {
          "id": "req-spec-001",
          "type": "document",
          "stage": "requirements-analysis",
          "status": "approved"
        },
        {
          "id": "arch-decision-001",
          "type": "adr",
          "stage": "architecture-design",
          "status": "approved"
        },
        {
          "id": "component-diagram-001",
          "type": "diagram",
          "stage": "architecture-design",
          "status": "approved"
        },
        {
          "id": "api-spec-v1-002",
          "type": "document",
          "stage": "architecture-design",
          "status": "in_review"
        }
      ],
      "history": [
        {
          "timestamp": "2026-04-11T10:00:00Z",
          "event": "initialized",
          "from_state": null,
          "to_state": "initialized",
          "agent": "build-orchestrator",
          "details": {
            "message": "Workflow initialized for feature/user-authentication"
          }
        },
        {
          "timestamp": "2026-04-11T10:05:00Z",
          "event": "state_transition",
          "from_state": "initialized",
          "to_state": "requirements-analysis",
          "agent": "build-orchestrator",
          "details": {
            "message": "Starting requirements analysis stage"
          }
        },
        {
          "timestamp": "2026-04-11T10:30:00Z",
          "event": "stage_started",
          "from_state": "requirements-analysis",
          "to_state": "requirements-analysis",
          "agent": "build-orchestrator",
          "details": {
            "stage": "requirements-analysis"
          }
        },
        {
          "timestamp": "2026-04-11T11:00:00Z",
          "event": "artifact_created",
          "from_state": "requirements-analysis",
          "to_state": "requirements-analysis",
          "agent": "build-orchestrator",
          "details": {
            "artifact_id": "req-spec-001",
            "message": "Requirements specification created"
          }
        },
        {
          "timestamp": "2026-04-11T11:30:00Z",
          "event": "stage_completed",
          "from_state": "requirements-analysis",
          "to_state": "requirements-analysis",
          "agent": "build-orchestrator",
          "details": {
            "stage": "requirements-analysis",
            "duration_seconds": 1800
          }
        },
        {
          "timestamp": "2026-04-11T11:35:00Z",
          "event": "agent_handoff",
          "from_state": "requirements-analysis",
          "to_state": "architecture-design",
          "agent": "build-orchestrator",
          "details": {
            "handoff_to": "platform-architect",
            "message": "Handing off to platform architect for architecture design"
          }
        },
        {
          "timestamp": "2026-04-11T12:00:00Z",
          "event": "state_transition",
          "from_state": "requirements-analysis",
          "to_state": "architecture-design",
          "agent": "platform-architect",
          "details": {
            "message": "Architecture design stage started"
          }
        },
        {
          "timestamp": "2026-04-11T13:00:00Z",
          "event": "artifact_created",
          "from_state": "architecture-design",
          "to_state": "architecture-design",
          "agent": "platform-architect",
          "details": {
            "artifact_id": "arch-decision-001",
            "message": "Architecture decision record created"
          }
        },
        {
          "timestamp": "2026-04-11T13:30:00Z",
          "event": "artifact_created",
          "from_state": "architecture-design",
          "to_state": "architecture-design",
          "agent": "platform-architect",
          "details": {
            "artifact_id": "component-diagram-001",
            "message": "Component diagram created"
          }
        },
        {
          "timestamp": "2026-04-11T14:00:00Z",
          "event": "stage_completed",
          "from_state": "architecture-design",
          "to_state": "architecture-design",
          "agent": "platform-architect",
          "details": {
            "stage": "architecture-design",
            "duration_seconds": 7200
          }
        },
        {
          "timestamp": "2026-04-11T14:05:00Z",
          "event": "agent_handoff",
          "from_state": "architecture-design",
          "to_state": "implementation",
          "agent": "platform-architect",
          "details": {
            "handoff_to": "backend-developer",
            "message": "Handing off to backend developer for implementation"
          }
        },
        {
          "timestamp": "2026-04-11T14:30:00Z",
          "event": "state_transition",
          "from_state": "architecture-design",
          "to_state": "implementation",
          "agent": "backend-developer",
          "details": {
            "message": "Implementation stage started"
          }
        }
      ],
      "metadata": {
        "created_at": "2026-04-11T10:00:00Z",
        "updated_at": "2026-04-11T14:30:00Z",
        "started_at": "2026-04-11T10:05:00Z",
        "completed_at": null,
        "created_by": "user@example.com",
        "workflow_type": "feature-development",
        "priority": "high",
        "issue_id": "PROJ-123",
        "branch": "feature/user-authentication",
        "commit": "abc123def456789",
        "environment": "development",
        "tags": ["feature", "authentication", "oauth2"],
        "progress": {
          "total_stages": 5,
          "completed_stages": 2,
          "percentage": 40,
          "current_stage": "implementation"
        },
        "configuration": {
          "timeout_seconds": 7200,
          "retry_on_failure": true,
          "max_retries": 3,
          "notifications": {
            "on_success": ["dev-team@example.com"],
            "on_failure": ["devops@example.com"],
            "on_completion": ["pm@example.com"]
          }
        }
      }
    }
  ]
}
