          "size_bytes": 102400,
          "content_type": "image/png",
          "uploaded_at": "2026-04-02T11:00:00Z",
          "uploaded_by": "pm@example.com"
        }
      ],
      "links": [
        {
          "type": "is_blocked_by",
          "target": "PROJ-100",
          "description": "Database schema changes needed first"
        }
      ],
      "sprint": {
        "id": "sprint-15",
        "name": "Sprint 15 - Q2 Release",
        "state": "active",
        "start_date": "2026-04-01T09:00:00Z",
        "end_date": "2026-04-15T18:00:00Z"
      },
      "estimates": {
        "story_points": 8,
        "hours_estimate": 32,
        "remaining_hours": 16
      },
      "source": {
        "system": "jira",
        "url": "https://jira.example.com/browse/PROJ-123",
        "project": "PROJECT-1",
        "external_id": "100001"
      }
    },
    {
